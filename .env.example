# --- Database (required) ---------------------------------------------------
# Any Postgres works. Recommended: Vercel Postgres (Neon) or Neon directly.
# Use the POOLED connection string here (needed for serverless — many
# short-lived connections from Vercel functions).
DATABASE_URL="postgresql://user:password@host-pooler:5432/trueodd?sslmode=require"

# `prisma migrate deploy` (runs automatically during `npm run build`) needs
# a DIRECT, non-pooled connection — it uses a session-level advisory lock
# that a pooled/PgBouncer connection breaks (fails with error P1002,
# "timed out trying to acquire a postgres advisory lock"). Neon's Vercel
# integration creates both a pooled and an unpooled connection string —
# find the unpooled one (often shown as "DATABASE_URL_UNPOOLED" or
# "POSTGRES_URL_NON_POOLING" in the Storage tab / Neon console) and set it
# here. Only migrations use this; normal app queries still use the pooled
# DATABASE_URL above.
DIRECT_URL="postgresql://user:password@host:5432/trueodd?sslmode=require"

# --- Kalshi API credentials (required for the BRTI feed) -------------------
# Generate an API key pair at kalshi.com/account/profile -> API Keys.
# Market/orderbook REST reads work without credentials, but the CF
# Benchmarks BRTI REST passthrough (/cfbenchmarks/values) requires a signed
# request even for public index data.
KALSHI_API_KEY_ID="your-kalshi-api-key-id"
# Paste the PEM private key. Easiest as a single line with literal \n:
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----\n"
# Alternative: base64-encode the whole PEM file and set this instead.
# KALSHI_PRIVATE_KEY_BASE64="..."

# --- Kalshi endpoints (optional — defaults target production) --------------
# KALSHI_API_BASE="https://api.elections.kalshi.com/trade-api/v2"
# KALSHI_BTC_SERIES_TICKER="KXBTC15M"

# --- Vercel Cron (optional) -------------------------------------------------
# If set, /api/cron/tick requires this as a Bearer token. Vercel sends it
# automatically for jobs defined in vercel.json once this env var exists.
# CRON_SECRET="a-long-random-string"
